{
  "name": "pehpeletz-stars",
  "private": true,
  "type": "module",
  "description": "דף נחיתה, תשלום ומערכת ניהול לערכת 'הכוכבים של פהפלצת'",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "shared",
    "site",
    "admin"
  ],
  "scripts": {
    "dev": "npm run dev -w site",
    "build": "npm run build -w site && npm run build -w admin",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w site && npm run typecheck -w admin",
    "test": "vitest run",
    "db:validate": "bash scripts/db-validate.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@netlify/functions": "6.1.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  }
}
