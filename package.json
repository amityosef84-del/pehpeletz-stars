{
  "name": "pehpeletz-stars",
  "private": true,
  "type": "module",
  "description": "דף נחיתה, תשלום ומערכת ניהול לערכת 'הכוכבים של פהפלצת'",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "shared",
    "site",
    "admin"
  ],
  "scripts": {
    "dev": "npm run dev -w site",
    "build": "npm run build -w site && npm run build -w admin",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w site && npm run typecheck -w admin",
    "test": "vitest run",
    "db:validate": "bash scripts/db-validate.sh",
    "qa:a11y": "node scripts/qa/a11y.mjs http://127.0.0.1:4321",
    "qa:checkout": "node scripts/qa/checkout-flow.mjs http://127.0.0.1:4321",
    "qa:shots": "node scripts/qa/shots.mjs http://127.0.0.1:4321 qa-shots / /checkout /privacy",
    "qa:lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@netlify/functions": "6.1.1",
    "@types/node": "22.20.5",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  }
}
