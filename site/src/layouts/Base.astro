---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** נתיב ל-OG image ב-public */
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  headerCta?: boolean;
  whatsapp?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og.jpg',
  noindex = false,
  jsonLd,
  headerCta = true,
  whatsapp = true,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.brand}` : `${site.brand} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const robots = !site.indexable || noindex ? 'noindex, nofollow' : 'index, follow';
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#04111a" />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href="/fonts/rubik-hebrew.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/rubik-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      דילוג לתוכן הראשי
    </a>
    <canvas class="starfield" data-starfield aria-hidden="true"></canvas>
    <div class="nebula" aria-hidden="true"></div>
    <slot name="before-header" />
    <Header showCta={headerCta} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {whatsapp && <WhatsAppFab />}
    <slot name="after-footer" />
    <ConsentBanner />
    <script>
      import '../scripts/fx';
      import '../scripts/starfield';
      // הסדר חשוב: הפיקסלים מאזינים לפני שהמעקב שולח page_view
      import '../scripts/pixels';
      import '../scripts/consent';
      import '../scripts/track';
    </script>
  </body>
</html>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
  .nebula {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background:
      radial-gradient(60% 45% at 80% 0%, rgb(25 198 184 / 0.18), transparent 70%),
      radial-gradient(50% 40% at 0% 35%, rgb(91 63 214 / 0.16), transparent 70%),
      radial-gradient(70% 50% at 100% 100%, rgb(25 198 184 / 0.1), transparent 70%),
      linear-gradient(180deg, var(--space-900), var(--space-950));
  }
  main {
    display: block;
    outline: none;
  }
</style>
