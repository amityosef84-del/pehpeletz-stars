---
import Base from './Base.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description?: string;
  updated?: string;
  /** טיוטה שממתינה לבדיקה משפטית */
  draft?: boolean;
}
const { title, description, updated = site.legal.policiesUpdated, draft = true } = Astro.props;
---

<Base title={title} description={description}>
  <article class="prose container">
    <header class="prose__head">
      <h1>{title}</h1>
      <p class="prose__meta">עודכן לאחרונה: {updated}</p>
      {draft && (
        <p class="prose__draft" role="note">
          טיוטה לבדיקת עורך דין. סעיפים מסומנים בצהוב ממתינים להשלמה.
        </p>
      )}
    </header>
    <div class="prose__body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .prose {
    max-width: 820px;
    padding-block: 24px 96px;
  }
  .prose__head h1 {
    font-size: var(--step-3);
  }
  .prose__meta {
    margin-top: 8px;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .prose__draft {
    margin-top: 14px;
    padding: 10px 14px;
    border-radius: var(--radius-s);
    border: 1px dashed var(--gold-400);
    background: rgb(255 201 74 / 0.1);
    color: var(--gold-300);
    font-weight: 600;
    font-size: var(--step--1);
  }
  .prose__body {
    margin-top: 28px;
    line-height: 1.8;
  }
  .prose__body :global(h2) {
    font-size: var(--step-2);
    margin: 36px 0 10px;
  }
  .prose__body :global(h3) {
    font-size: var(--step-1);
    margin: 22px 0 6px;
  }
  .prose__body :global(p),
  .prose__body :global(li) {
    color: #dbe9ef;
  }
  .prose__body :global(p + p) {
    margin-top: 10px;
  }
  .prose__body :global(ul),
  .prose__body :global(ol) {
    padding-inline-start: 1.4em;
    display: grid;
    gap: 6px;
    margin: 10px 0;
  }
  .prose__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 12px 0;
    font-size: var(--step--1);
  }
  .prose__body :global(th),
  .prose__body :global(td) {
    border: 1px solid var(--stroke-strong);
    padding: 8px 10px;
    text-align: start;
    vertical-align: top;
  }
  .prose__body :global(th) {
    background: var(--surface-2);
  }
</style>
