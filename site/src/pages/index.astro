---
// שלב 0: עמוד placeholder. דף הנחיתה המלא נבנה בשלב 1.
const title = 'הכוכבים של פהפלצת';
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: dark;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        background: radial-gradient(ellipse at top, #0b3a44 0%, #031016 70%);
        color: #f2fbff;
        font-family:
          system-ui,
          -apple-system,
          'Segoe UI',
          Arial,
          sans-serif;
        text-align: center;
        padding: 1.5rem;
      }
      h1 {
        font-size: clamp(1.75rem, 6vw, 3rem);
        margin: 0 0 0.5rem;
      }
      p {
        margin: 0;
        opacity: 0.85;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>האתר החדש בבנייה. נתראה בקרוב בין הכוכבים.</p>
    </main>
  </body>
</html>
