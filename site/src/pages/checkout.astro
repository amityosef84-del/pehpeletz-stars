---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/ui/Icon.astro';
import { DEFAULT_PACKAGE, formatIls, packages, quote } from '../config/packages';
import { site } from '../config/site';
import box from '../assets/photos/box-front.webp';

const options = packages.map((p) => ({ ...p, q: quote(p.slug) }));
const initial = options.find((o) => o.slug === DEFAULT_PACKAGE) ?? options[0]!;
---

<Base title="השלמת הזמנה" noindex headerCta={false}>
  <section class="checkout container" aria-labelledby="co-title">
    <header class="checkout__head">
      <a href="/#pricing" class="checkout__back">
        <Icon name="arrow" size={18} class="flip" /> חזרה לחבילות
      </a>
      <h1 id="co-title">עוד רגע, והגיבורים בדרך אליכם</h1>
      <p>ממלאים פרטים למשלוח, ובשלב הבא משלמים בעמוד תשלום מאובטח. בלי הרשמה ובלי סיסמאות.</p>
    </header>

    <form
      id="checkout-form"
      class="checkout__grid"
      novalidate
      data-enabled={site.checkoutEnabled ? 'true' : 'false'}
      data-whatsapp={site.whatsapp}
    >
      <div class="checkout__main">
        <p class="checkout__errors" role="alert" aria-live="assertive" hidden></p>

        <fieldset class="co-box card">
          <legend>
            <span class="co-step">1</span> החבילה שלכם
          </legend>
          <div class="pkg-options">
            {options.map((o) => (
              <label class="pkg-opt">
                <input
                  type="radio"
                  name="package"
                  value={o.slug}
                  checked={o.slug === initial.slug}
                  data-units={o.units}
                  data-name={o.name}
                  data-total={o.q.total}
                  data-shipping={o.q.shipping}
                />
                <span class="pkg-opt__body">
                  <span class="pkg-opt__name">{o.name}</span>
                  <span class="pkg-opt__aud">
                    {o.audience} · {o.units === 1 ? 'ערכה אחת' : `${o.units} ערכות`}
                  </span>
                  <span class="pkg-opt__price">{formatIls(o.q.total)}</span>
                  {o.badge && <span class="pkg-opt__badge">{o.badge}</span>}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="co-box card">
          <legend>
            <span class="co-step">2</span> פרטים ליצירת קשר
          </legend>
          <div class="fields">
            <div class="field field--full">
              <label for="f-name">שם מלא</label>
              <input
                id="f-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                minlength="2"
                maxlength="80"
                aria-describedby="f-name-err"
              />
              <p class="field__err" id="f-name-err"></p>
            </div>
            <div class="field">
              <label for="f-phone">טלפון נייד</label>
              <input
                id="f-phone"
                name="phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                dir="ltr"
                required
                maxlength="20"
                placeholder="050-1234567"
                aria-describedby="f-phone-hint f-phone-err"
              />
              <p class="field__hint" id="f-phone-hint">
                לתיאום המשלוח בלבד
              </p>
              <p class="field__err" id="f-phone-err"></p>
            </div>
            <div class="field">
              <label for="f-email">אימייל</label>
              <input
                id="f-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                dir="ltr"
                required
                maxlength="120"
                placeholder="name@example.com"
                aria-describedby="f-email-hint f-email-err"
              />
              <p class="field__hint" id="f-email-hint">
                לשם נשלחים אישור ההזמנה והחשבונית
              </p>
              <p class="field__err" id="f-email-err"></p>
            </div>
          </div>
        </fieldset>

        <fieldset class="co-box card">
          <legend>
            <span class="co-step">3</span> כתובת למשלוח
          </legend>
          <div class="fields">
            <div class="field field--full">
              <label for="f-city">עיר / יישוב</label>
              <input
                id="f-city"
                name="city"
                type="text"
                autocomplete="address-level2"
                required
                maxlength="60"
                aria-describedby="f-city-err"
              />
              <p class="field__err" id="f-city-err"></p>
            </div>
            <div class="field field--grow">
              <label for="f-street">רחוב</label>
              <input
                id="f-street"
                name="street"
                type="text"
                autocomplete="address-line1"
                required
                maxlength="80"
                aria-describedby="f-street-err"
              />
              <p class="field__err" id="f-street-err"></p>
            </div>
            <div class="field field--small">
              <label for="f-house">מספר בית</label>
              <input
                id="f-house"
                name="house"
                type="text"
                inputmode="numeric"
                required
                maxlength="8"
                aria-describedby="f-house-err"
              />
              <p class="field__err" id="f-house-err"></p>
            </div>
            <div class="field">
              <label for="f-apt">
                דירה / קומה / כניסה <span class="opt">(לא חובה)</span>
              </label>
              <input
                id="f-apt"
                name="apartment"
                type="text"
                autocomplete="address-line2"
                maxlength="40"
              />
            </div>
            <div class="field">
              <label for="f-zip">
                מיקוד <span class="opt">(לא חובה)</span>
              </label>
              <input
                id="f-zip"
                name="zip"
                type="text"
                inputmode="numeric"
                autocomplete="postal-code"
                dir="ltr"
                maxlength="7"
                aria-describedby="f-zip-err"
              />
              <p class="field__err" id="f-zip-err"></p>
            </div>
            <div class="field field--full">
              <label for="f-notes">
                הערות לשליח <span class="opt">(לא חובה)</span>
              </label>
              <textarea
                id="f-notes"
                name="notes"
                rows="2"
                maxlength="300"
                placeholder="למשל: קוד לבניין, להשאיר ליד הדלת"
              ></textarea>
            </div>
          </div>
        </fieldset>

        <!-- מלכודת לבוטים: מוסתר מבני אדם ומקוראי מסך -->
        <div class="hp" aria-hidden="true">
          <label for="f-company">Company</label>
          <input id="f-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
      </div>

      <aside class="checkout__aside" aria-labelledby="sum-title">
        <div class="summary card">
          <h2 id="sum-title">סיכום הזמנה</h2>
          <div class="summary__item">
            <div class="summary__img" data-vt-box>
              <Picture
                fallbackFormat="webp"
                src={box}
                formats={['avif', 'webp']}
                widths={[160, 320]}
                sizes="96px"
                alt=""
                loading="eager"
              />
              <span class="summary__qty" data-sum-units>
                {initial.units}
              </span>
            </div>
            <div>
              <p class="summary__name" data-sum-name>
                {initial.name}
              </p>
              <p class="summary__sub">ספר, לוח, מדבקות, מברשת וחוברת צביעה לכל ילד</p>
            </div>
          </div>
          <dl class="summary__rows">
            <div>
              <dt>
                ערכות (<span data-sum-units2>{initial.units}</span>)
              </dt>
              <dd class="text-teal">במתנה</dd>
            </div>
            <div>
              <dt>
                משלוח עד הבית <span class="summary__muted">(50&nbsp;₪ לערכה)</span>
              </dt>
              <dd data-sum-shipping>{formatIls(initial.q.shipping)}</dd>
            </div>
            <div class="summary__total">
              <dt>סה״כ לתשלום</dt>
              <dd data-sum-total>{formatIls(initial.q.total)}</dd>
            </div>
          </dl>

          <details class="coupon">
            <summary>יש לכם קוד קופון?</summary>
            <div class="coupon__row">
              <label for="f-coupon" class="visually-hidden">
                קוד קופון
              </label>
              <input
                id="f-coupon"
                name="coupon"
                type="text"
                form="checkout-form"
                autocomplete="off"
                autocapitalize="characters"
                dir="ltr"
                maxlength="40"
              />
              <p class="field__hint">הקופון ייבדק ויחושב בשלב התשלום.</p>
            </div>
          </details>

          <div class="consents">
            <div class="check">
              <input
                id="f-terms"
                name="terms"
                type="checkbox"
                form="checkout-form"
                required
                aria-describedby="f-terms-err"
              />
              <label for="f-terms">
                קראתי ואני מסכים/ה ל
                <a href="/terms" target="_blank">
                  תקנון
                </a>{' '}
                ול
                <a href="/returns" target="_blank">
                  מדיניות הביטול וההחזרות
                </a>
              </label>
            </div>
            <p class="field__err" id="f-terms-err"></p>
            <div class="check">
              <input id="f-marketing" name="marketing" type="checkbox" form="checkout-form" />
              <label for="f-marketing">
                אשמח לקבל עדכונים, טיפים ומבצעים במייל וב-SMS (אפשר להסיר בכל עת)
              </label>
            </div>
          </div>

          <button type="submit" form="checkout-form" class="pay" data-pay>
            <Icon name="lock" size={20} />
            <span data-pay-label>
              לתשלום מאובטח · <span data-sum-total2>{formatIls(initial.q.total)}</span>
            </span>
          </button>

          <ul class="summary__trust">
            <li>
              <Icon name="shield" size={18} /> תשלום בעמוד המאובטח של SUMIT. פרטי האשראי לא עוברים
              דרכנו ולא נשמרים אצלנו.
            </li>
            <li>
              <Icon name="truck" size={18} /> משלוח עד הבית תוך עד {site.shipping.maxBusinessDays}{' '}
              ימי עסקים.
            </li>
            <li>
              <Icon name="check" size={18} />
              <span>
                אפשר לבטל תוך {site.returnsDays} יום מקבלת הערכה, כשהיא באריזתה המקורית והסגורה.
                <a href="/returns" target="_blank">
                  למדיניות המלאה
                </a>
              </span>
            </li>
          </ul>

          <div class="soon" data-soon hidden tabindex="-1">
            <p class="soon__title">ההזמנות באתר נפתחות ממש בקרוב</p>
            <p>בינתיים אפשר להשלים את ההזמנה איתנו בוואטסאפ. הכנו לכם הודעה עם כל הפרטים.</p>
            <a
              class="soon__wa"
              href="#"
              data-soon-link
              target="_blank"
              rel="noopener"
              data-whatsapp="checkout"
            >
              <Icon name="whatsapp" size={22} /> להשלמת ההזמנה בוואטסאפ
            </a>
          </div>
        </div>
      </aside>
    </form>
  </section>
</Base>

<style>
  .checkout {
    padding-block: 18px 80px;
  }
  .checkout__head {
    max-width: 720px;
  }
  .checkout__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
  }
  .checkout__back :global(.flip) {
    transform: scaleX(-1);
  }
  .checkout__head h1 {
    font-size: var(--step-3);
    margin-top: 4px;
  }
  .checkout__head p {
    margin-top: 8px;
    color: var(--text-muted);
  }
  .checkout__grid {
    margin-top: 24px;
    display: grid;
    gap: 18px;
    align-items: start;
  }
  @media (min-width: 980px) {
    .checkout__grid {
      grid-template-columns: 1fr 400px;
      gap: 28px;
    }
    .checkout__aside {
      position: sticky;
      top: calc(var(--header-h) + 12px);
    }
  }
  .checkout__main {
    display: grid;
    gap: 18px;
  }
  .checkout__errors {
    padding: 12px 16px;
    border-radius: var(--radius-s);
    background: rgb(255 143 143 / 0.12);
    border: 1px solid rgb(255 143 143 / 0.5);
    color: var(--danger);
    font-weight: 700;
  }
  .co-box {
    margin: 0;
    min-width: 0;
    padding: 20px 18px 22px;
    border-radius: var(--radius-l);
  }
  @media (min-width: 720px) {
    .co-box {
      padding: 26px 26px 28px;
    }
  }
  .co-box legend {
    float: inline-start;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding: 0;
    font-size: var(--step-1);
    font-weight: 800;
  }
  .co-box legend + * {
    clear: both;
  }
  .co-step {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    font-size: 0.95rem;
    color: var(--text-on-gold);
    background: linear-gradient(180deg, var(--gold-300), var(--gold-500));
  }

  /* ---------- בחירת חבילה ---------- */
  .pkg-options {
    display: grid;
    gap: 10px;
  }
  @media (min-width: 560px) {
    .pkg-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .pkg-opt {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: var(--radius-m);
    border: 1.5px solid var(--stroke-strong);
    background: var(--surface-1);
    cursor: pointer;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .pkg-opt:hover {
    border-color: rgb(255 201 74 / 0.6);
  }
  .pkg-opt:has(input:checked) {
    border-color: var(--gold-400);
    background: rgb(255 201 74 / 0.1);
    box-shadow: 0 0 0 1px var(--gold-400);
  }
  .pkg-opt:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .pkg-opt input {
    flex: none;
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--gold-400);
  }
  .pkg-opt__body {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 10px;
    width: 100%;
  }
  .pkg-opt__name {
    font-weight: 800;
  }
  .pkg-opt__aud {
    grid-column: 1;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .pkg-opt__price {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-weight: 900;
    font-size: var(--step-1);
    color: var(--gold-300);
    white-space: nowrap;
  }
  .pkg-opt__badge {
    position: absolute;
    top: -10px;
    inset-inline-end: 14px;
    padding: 1px 10px;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--text-on-gold);
    background: var(--gold-400);
  }

  /* ---------- שדות ---------- */
  .fields {
    display: grid;
    gap: 14px 14px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .field--full {
      grid-column: 1 / -1;
    }
    .fields:has(.field--grow) {
      grid-template-columns: 2fr 1fr;
    }
  }
  .field {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .field label {
    font-weight: 700;
    font-size: var(--step--1);
  }
  .opt {
    font-weight: 400;
    color: var(--text-muted);
  }
  input[type='text'],
  input[type='tel'],
  input[type='email'],
  textarea {
    width: 100%;
    min-height: 50px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1.5px solid rgb(255 255 255 / 0.28);
    background: rgb(2 8 14 / 0.55);
    color: var(--text);
    font-size: 16px; /* מונע זום אוטומטי ב-iOS */
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  textarea {
    resize: vertical;
    min-height: 70px;
  }
  input::placeholder,
  textarea::placeholder {
    color: rgb(182 208 218 / 0.6);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--gold-400);
    box-shadow: 0 0 0 3px rgb(255 224 138 / 0.35);
    border-radius: 12px;
  }
  input[aria-invalid='true'] {
    border-color: var(--danger);
  }
  [dir='ltr']::placeholder {
    text-align: right;
  }
  input[dir='ltr'] {
    text-align: right;
  }
  .field__hint {
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .field__err {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--danger);
  }
  .field__err:empty {
    display: none;
  }
  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    inset-inline-start: -9999px;
  }

  /* ---------- סיכום ---------- */
  .summary {
    padding: 22px 20px;
    border-radius: var(--radius-l);
    border-color: rgb(255 201 74 / 0.3);
  }
  .summary h2 {
    font-size: var(--step-1);
  }
  .summary__item {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 14px;
  }
  .summary__img {
    position: relative;
    flex: none;
    width: 96px;
  }
  .summary__img :global(img) {
    width: 100%;
    border-radius: 4px;
    box-shadow: 0 10px 20px -8px rgb(0 0 0 / 0.8);
  }
  .summary__qty {
    position: absolute;
    top: -8px;
    inset-inline-end: -8px;
    display: grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    border-radius: var(--radius-pill);
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--text-on-gold);
    background: var(--gold-400);
  }
  .summary__name {
    font-weight: 800;
  }
  .summary__sub {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.4;
  }
  .summary__rows {
    margin: 18px 0 0;
    display: grid;
    gap: 8px;
  }
  .summary__rows > div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .summary__rows dd {
    margin: 0;
    font-weight: 700;
    white-space: nowrap;
  }
  .summary__muted {
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .summary__total {
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--stroke-strong);
    font-size: var(--step-1);
    font-weight: 800;
  }
  .summary__total dd {
    color: var(--gold-300);
    font-weight: 900;
  }
  .coupon {
    margin-top: 14px;
  }
  .coupon summary {
    cursor: pointer;
    min-height: 40px;
    display: flex;
    align-items: center;
    color: var(--teal-300);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .coupon__row {
    display: grid;
    gap: 6px;
    margin-top: 6px;
  }
  .consents {
    margin-top: 16px;
    display: grid;
    gap: 10px;
  }
  .check {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: var(--step--1);
  }
  .check input {
    flex: none;
    width: 22px;
    height: 22px;
    margin: 1px 0 0;
    accent-color: var(--gold-400);
  }
  .pay {
    margin-top: 18px;
    width: 100%;
    min-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 0;
    border-radius: var(--radius-pill);
    font-size: var(--step-1);
    font-weight: 900;
    color: var(--text-on-gold);
    background: linear-gradient(180deg, var(--gold-300), var(--gold-500));
    box-shadow:
      var(--shadow-glow-gold),
      inset 0 2px 0 rgb(255 255 255 / 0.55);
    cursor: pointer;
    transition: transform 0.25s var(--ease-spring);
  }
  .pay:hover {
    transform: translateY(-2px);
  }
  .pay[aria-busy='true'] {
    opacity: 0.75;
    cursor: progress;
  }
  .summary__trust {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    display: grid;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .summary__trust li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .summary__trust :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--teal-300);
  }
  .soon {
    margin-top: 18px;
    padding: 16px;
    border-radius: var(--radius-m);
    background: rgb(26 163 74 / 0.12);
    border: 1px solid rgb(26 163 74 / 0.5);
  }
  .soon__title {
    font-weight: 800;
    font-size: var(--step-1);
  }
