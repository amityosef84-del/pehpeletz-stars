---
import { landing } from '../../config/landing';
const g = landing.guarantee;
---

<section class="guarantee" aria-labelledby="guarantee-title">
  <div class="container">
    <div class="guarantee__card card" data-reveal>
      <div class="guarantee__seal" aria-hidden="true">
        <span class="guarantee__ring"></span>
        <span class="guarantee__num">14</span>
        <span class="guarantee__days">יום</span>
      </div>
      <div>
        <h2 id="guarantee-title" class="guarantee__title">
          {g.title}
        </h2>
        <p class="guarantee__text">{g.text}</p>
        <a href="/returns" class="guarantee__link">
          {g.link}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .guarantee {
    padding-block: 24px;
  }
  .guarantee__card {
    display: grid;
    gap: 22px;
    align-items: center;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-l);
    border-color: rgb(63 224 208 / 0.35);
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(63 224 208 / 0.14), transparent 60%),
      linear-gradient(180deg, var(--surface-2), var(--surface-1));
  }
  @media (min-width: 720px) {
    .guarantee__card {
      grid-template-columns: auto 1fr;
      gap: 36px;
    }
  }
  .guarantee__seal {
    position: relative;
    width: 128px;
    height: 128px;
    margin-inline: auto;
    display: grid;
    place-items: center;
    align-content: center;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--teal-300), var(--teal-500) 55%, #0a6d66);
    color: var(--space-950);
    box-shadow: 0 0 40px rgb(63 224 208 / 0.45);
  }
  .guarantee__ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 2px dashed rgb(138 245 234 / 0.6);
  }
  @media (prefers-reduced-motion: no-preference) {
    .guarantee__ring {
      animation: rotate 22s linear infinite;
    }
  }
  @keyframes rotate {
    to {
      transform: rotate(360deg);
    }
  }
  .guarantee__num {
    font-size: 2.8rem;
    font-weight: 900;
    line-height: 1;
  }
  .guarantee__days {
    font-weight: 800;
  }
  .guarantee__title {
    font-size: var(--step-2);
  }
  .guarantee__text {
    margin-top: 10px;
    color: var(--text-muted);
    max-width: 60ch;
  }
  .guarantee__link {
    display: inline-block;
    margin-top: 10px;
    font-weight: 700;
  }
</style>
