---
import { Picture } from 'astro:assets';
import { landing } from '../../config/landing';
import CtaButton from '../ui/CtaButton.astro';
import Icon from '../ui/Icon.astro';
import box from '../../assets/photos/box-front.webp';
import guyFly from '../../assets/chars/guy-fly.webp';
import robotFly from '../../assets/chars/robot-fly.webp';
import floraWarrior from '../../assets/chars/flora-warrior.webp';
import title3d from '../../assets/brand/title-3d.webp';

const h = landing.hero;
const trustIcons = ['shield', 'truck', 'lock'] as const;
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__brand">
        <Picture
          fallbackFormat="webp"
          src={title3d}
          formats={['avif', 'webp']}
          widths={[320, 640]}
          sizes="(min-width: 960px) 360px, 72vw"
          alt="הכוכבים של פהפלצת"
          loading="eager"
        />
      </p>
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        <span>{h.title}</span>
        <span class="hero__accent shine-text">{h.titleAccent}</span>
      </h1>

      <div class="hero__offer">
        <span class="hero__offer-strong">
          <Icon name="gift" size={20} /> {h.offer.strong}
        </span>
        <span>{h.offer.rest}</span>
      </div>

      <div class="hero__ctas">
        <CtaButton href="#pricing" location="hero">
          {h.cta}
        </CtaButton>
        <a class="hero__secondary" href="#kit" data-cta="hero-secondary">
          {h.secondary}
        </a>
      </div>

      <p class="hero__lead">{h.lead}</p>

      <ul class="hero__trust" aria-label="למה לקנות בביטחון">
        {h.trust.map((t, i) => (
          <li>
            <Icon name={trustIcons[i] ?? 'check'} size={20} />
            {t}
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__stage" data-parallax aria-hidden="true">
      <div class="hero__glow"></div>
      <div class="hero__orbit hero__orbit--1"></div>
      <div class="hero__orbit hero__orbit--2"></div>
      <div class="hero__orbit hero__orbit--3">
        <span></span>
      </div>

      <div class="hero__layer hero__box" style="--depth: 10">
        <div class="hero__box-float">
          <Picture
            fallbackFormat="webp"
            src={box}
            formats={['avif', 'webp']}
            widths={[360, 540, 760, 1080]}
            sizes="(min-width: 960px) 460px, 74vw"
            alt=""
            loading="eager"
            fetchpriority="high"
            class="hero__box-img"
          />
          <span class="hero__sheen"></span>
        </div>
        <span class="hero__shadow"></span>
      </div>

      <div class="hero__layer hero__char hero__char--guy" style="--depth: 26">
        <Picture
          fallbackFormat="webp"
          src={guyFly}
          formats={['avif', 'webp']}
          widths={[220, 440]}
          sizes="200px"
          alt=""
          loading="eager"
        />
      </div>
      <div class="hero__layer hero__char hero__char--robot" style="--depth: 34">
        <Picture
          fallbackFormat="webp"
          src={robotFly}
          formats={['avif', 'webp']}
          widths={[200, 400]}
          sizes="180px"
          alt=""
          loading="eager"
        />
      </div>
      <div class="hero__layer hero__char hero__char--flora" style="--depth: 18">
        <Picture
          fallbackFormat="webp"
          src={floraWarrior}
          formats={['avif', 'webp']}
          widths={[160, 320]}
          sizes="150px"
          alt=""
          loading="eager"
        />
      </div>

      <span class="hero__twinkle" style="--x: 12%; --y: 18%; --d: 0s"></span>
      <span class="hero__twinkle" style="--x: 86%; --y: 30%; --d: 1.2s"></span>
      <span class="hero__twinkle" style="--x: 70%; --y: 86%; --d: 2.1s"></span>
      <span class="hero__twinkle" style="--x: 24%; --y: 78%; --d: 0.6s"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow-x: clip;
    padding-block: 18px 72px;
  }
  .hero__grid {
    display: grid;
    gap: 8px;
    align-items: center;
  }
  .hero__copy {
    display: contents;
  }
  @media (min-width: 960px) {
    .hero {
      padding-block: 40px 110px;
    }
    .hero__grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 40px;
    }
    .hero__copy {
      display: block;
    }
  }

  /* סדר במובייל: כותרת → הצעה + CTA (מעל הקפל) → ויז'ואל → הסבר → אמון. הלוגו התלת־ממדי רק בדסקטופ. */
  @media (min-width: 960px) {
    .hero__brand {
      display: block;
    }
  }
  @media (max-width: 959px) {
    .hero__brand {
      display: none;
    }
  }
  .hero__brand {
    order: 1;
    width: min(320px, 72vw);
    margin-bottom: 4px;
    filter: drop-shadow(0 6px 18px rgb(0 0 0 / 0.6));
  }
  .eyebrow {
    order: 2;
  }
  .hero__title {
    order: 3;
    font-size: var(--step-4);
    margin-top: 8px;
    display: grid;
    gap: 4px;
  }
  .hero__accent {
    font-size: 0.78em;
  }
  .hero__offer {
    order: 4;
  }
  .hero__ctas {
    order: 5;
  }
  .hero__stage {
    order: 6;
  }
  .hero__lead {
    order: 7;
  }
  .hero__trust {
    order: 8;
  }

  .hero__offer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 18px;
    padding: 10px 16px;
    width: fit-content;
    border-radius: var(--radius-m);
    background: linear-gradient(90deg, rgb(255 201 74 / 0.16), rgb(63 224 208 / 0.08));
    border: 1px solid rgb(255 201 74 / 0.4);
    font-weight: 600;
  }
  .hero__offer-strong {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--gold-300);
    font-weight: 800;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
    margin-top: 18px;
  }
  .hero__ctas :global(.cta) {
    flex: 1 1 260px;
    max-width: 420px;
  }
  .hero__secondary {
    color: var(--text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(138 245 234 / 0.6);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .hero__lead {
    margin-top: 20px;
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 54ch;
  }
  .hero__trust {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero__trust :global(svg) {
    color: var(--teal-300);
  }

  /* ---------- הבמה ---------- */
  .hero__stage {
    --mx: 0;
    --my: 0;
    position: relative;
    aspect-ratio: 1 / 0.86;
    width: min(100%, 560px);
    margin: 18px auto 0;
  }
  @media (min-width: 960px) {
    .hero__stage {
      margin-top: 0;
      width: 100%;
    }
  }
  .hero__layer {
    position: absolute;
    transform: translate3d(
      calc(var(--mx) * var(--depth) * -1px),
      calc(var(--my) * var(--depth) * -1px),
      0
    );
    transition: transform 0.1s linear;
  }
  .hero__glow {
    position: absolute;
    inset: 4% 8%;
    border-radius: 50%;
    background:
      radial-gradient(
        closest-side,
        rgb(138 245 234 / 0.55),
        rgb(25 198 184 / 0.18) 45%,
        transparent 75%
      ),
      radial-gradient(closest-side at 60% 60%, rgb(91 63 214 / 0.5), transparent 70%);
    filter: blur(10px);
  }
  .hero__orbits {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--s);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgb(138 245 234 / 0.28);
    transform: translate(-50%, -50%) rotateX(72deg) rotateZ(0deg);
    box-shadow: 0 0 24px rgb(63 224 208 / 0.12) inset;
  }
  .hero__orbit--1 {
    --s: 70%;
  }
  .hero__orbit--2 {
    --s: 92%;
    border-color: rgb(255 201 74 / 0.22);
  }
  .hero__orbit--3 {
    --s: 112%;
    border-style: dashed;
    border-color: rgb(183 168 255 / 0.2);
  }
  .hero__orbit--3 span {
    position: absolute;
    top: -5px;
    left: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gold-300);
    box-shadow: 0 0 14px var(--gold-400);
  }

  .hero__box {
    inset: 14% 13% auto 13%;
    perspective: 900px;
  }
  .hero__box-float {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateY(calc(var(--mx) * -10deg - 8deg)) rotateX(calc(var(--my) * 8deg + 4deg));
    border-radius: 6px;
    box-shadow:
      0 40px 70px -20px rgb(0 0 0 / 0.85),
      0 0 60px -10px rgb(91 63 214 / 0.8);
  }
  .hero__box-float :global(img) {
    width: 100%;
    border-radius: 6px;
  }
  .hero__sheen {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgb(255 255 255 / 0.28) 45%,
      rgb(138 245 234 / 0.25) 50%,
      rgb(255 224 138 / 0.22) 55%,
      transparent 70%
    );
    background-size: 260% 100%;
    background-position: 130% 0;
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .hero__shadow {
    display: block;
    margin: 18px auto 0;
    width: 70%;
    height: 22px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.65), transparent);
  }

  .hero__char {
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.55));
  }
  .hero__char :global(img) {
    width: 100%;
  }
  .hero__char--guy {
    width: 34%;
    inset: auto auto 2% -2%;
  }
  .hero__char--robot {
    width: 30%;
    inset: 4% -2% auto auto;
  }
  .hero__char--flora {
    width: 23%;
    inset: -4% auto auto 6%;
  }
  .hero__twinkle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 16px;
    height: 16px;
    background: var(--gold-300);
    clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%);
    filter: drop-shadow(0 0 6px var(--gold-400));
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__box-float {
      animation: float 6s ease-in-out infinite;
    }
    .hero__sheen {
      animation: holo 5.5s var(--ease-out) infinite 1.5s;
    }
    .hero__shadow {
      animation: shadow 6s ease-in-out infinite;
    }
    .hero__char--guy :global(picture) {
      display: block;
      animation: bob 5s ease-in-out infinite;
    }
    .hero__char--robot :global(picture) {
      display: block;
      animation: bob 4.2s ease-in-out infinite -1.4s;
    }
    .hero__char--flora :global(picture) {
      display: block;
      animation: bob 5.6s ease-in-out infinite -2.8s;
    }
    .hero__orbit--1 {
      animation: spin 26s linear infinite;
    }
    .hero__orbit--3 {
      animation: spin 40s linear infinite reverse;
    }
    .hero__twinkle {
      animation: twinkle 2.6s ease-in-out infinite var(--d);
    }
    .hero__glow {
      animation: pulse 7s ease-in-out infinite;
    }
    /* כניסה: הקופסה והדמויות "נוחתות" מהגלקסיה */
    .hero__box {
      animation: land 1.1s var(--ease-out) both 0.15s;
    }
    .hero__char--guy {
      animation: fly-in-left 1.2s var(--ease-spring) both 0.45s;
    }
    .hero__char--robot {
      animation: fly-in-right 1.2s var(--ease-spring) both 0.6s;
    }
    .hero__char--flora {
      animation: fly-in-top 1.2s var(--ease-spring) both 0.75s;
    }
  }
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -14px;
    }
  }
  @keyframes shadow {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.82);
      opacity: 0.6;
    }
  }
  @keyframes holo {
    0%,
    55% {
      background-position: 130% 0;
    }
    100% {
      background-position: -130% 0;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-16px) rotate(2deg);
    }
  }
  @keyframes spin {
    to {
      transform: translate(-50%, -50%) rotateX(72deg) rotateZ(360deg);
    }
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.2;
      scale: 0.5;
    }
    50% {
      opacity: 1;
      scale: 1;
    }
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.85;
      scale: 1;
    }
    50% {
      opacity: 1;
      scale: 1.06;
    }
  }
  @keyframes land {
    from {
      opacity: 0;
      scale: 0.6;
      filter: blur(8px);
    }
  }
  @keyframes fly-in-left {
    from {
      opacity: 0;
      translate: -60% 40%;
      rotate: -20deg;
    }
  }
  @keyframes fly-in-right {
    from {
      opacity: 0;
      translate: 60% -30%;
      rotate: 20deg;
    }
  }
  @keyframes fly-in-top {
    from {
      opacity: 0;
      translate: 0 -60%;
    }
  }
</style>
