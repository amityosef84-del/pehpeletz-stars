---
import Icon from './Icon.astro';

interface Props {
  href: string;
  /** מיקום הכפתור, לאירוע cta_click בשלב 3 */
  location: string;
  variant?: 'primary' | 'ghost';
  size?: 'm' | 'l';
  class?: string;
  icon?: boolean;
}
const {
  href,
  location,
  variant = 'primary',
  size = 'l',
  class: className,
  icon = true,
} = Astro.props;
---

<a
  href={href}
  class:list={['cta', `cta--${variant}`, `cta--${size}`, className]}
  data-cta={location}
>
  <span class="cta__label">
    <slot />
  </span>
  {icon && <Icon name="arrow" size={20} class="cta__icon" />}
  {variant === 'primary' && <span class="cta__shine" aria-hidden="true" />}
</a>

<style>
  .cta {
    --pad-y: 14px;
    --pad-x: 26px;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: var(--pad-y) var(--pad-x);
    border-radius: var(--radius-pill);
    font-weight: 800;
    font-size: var(--step-0);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.25s var(--ease-spring),
      box-shadow 0.25s,
      background-color 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .cta--l {
    --pad-y: 17px;
    --pad-x: 34px;
    min-height: 58px;
    font-size: var(--step-1);
  }
  .cta--primary {
    color: var(--text-on-gold);
    background: linear-gradient(180deg, var(--gold-300), var(--gold-500));
    box-shadow:
      var(--shadow-glow-gold),
      inset 0 2px 0 rgb(255 255 255 / 0.55),
      inset 0 -3px 0 rgb(160 80 0 / 0.35);
  }
  .cta--primary:hover,
  .cta--primary:focus-visible {
    color: var(--text-on-gold);
    transform: translateY(-2px) scale(1.02);
    box-shadow:
      0 0 0 1px rgb(255 201 74 / 0.6),
      0 16px 50px -6px rgb(255 178 30 / 0.75),
      inset 0 2px 0 rgb(255 255 255 / 0.6),
      inset 0 -3px 0 rgb(160 80 0 / 0.35);
  }
  .cta--primary:active {
    transform: translateY(1px) scale(0.98);
  }
  .cta--ghost {
    color: var(--text);
    background: var(--surface-1);
    border: 1px solid var(--stroke-strong);
  }
  .cta--ghost:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .cta__icon {
    flex: none;
    transition: transform 0.3s var(--ease-spring);
  }
  .cta:hover .cta__icon {
    transform: translateX(-4px);
  }
  .cta__shine {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgb(255 255 255 / 0.7) 50%,
      transparent 65%
    );
    transform: translateX(120%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta__shine {
      animation: sweep 4.5s var(--ease-out) infinite 1.2s;
    }
  }
  @keyframes sweep {
    0%,
    70% {
      transform: translateX(120%);
    }
    100% {
      transform: translateX(-120%);
    }
  }
</style>
