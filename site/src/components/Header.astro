---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.webp';
import CtaButton from './ui/CtaButton.astro';

interface Props {
  /** בדף הנחיתה: כפתור "להזמנה" שמופיע אחרי גלילה */
  showCta?: boolean;
}
const { showCta = true } = Astro.props;
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="הכוכבים של פהפלצת: לדף הבית">
      <Image src={logo} alt="" width={150} height={66} loading="eager" decoding="async" />
    </a>
    {showCta && (
      <div class="site-header__cta">
        <CtaButton href="/#pricing" location="header" size="m" icon={false}>
          להזמנה
        </CtaButton>
      </div>
    )}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    transition:
      background-color 0.3s,
      box-shadow 0.3s,
      backdrop-filter 0.3s;
  }
  :global(.is-scrolled) .site-header {
    background: rgb(4 17 26 / 0.72);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 1px 0 var(--stroke);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .site-header__logo {
    display: block;
    width: clamp(112px, 22vw, 150px);
    filter: drop-shadow(0 4px 14px rgb(63 224 208 / 0.25));
  }
  .site-header__cta {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  :global(.is-scrolled) .site-header__cta {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  @media (scripting: none) {
    .site-header__cta {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }
</style>
