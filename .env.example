# שמות משתני הסביבה בלבד. הערכים מוגדרים ב-Netlify → Site configuration → Environment variables.
# לפיתוח מקומי: להעתיק ל-.env (מוחרג מ-git). אין לשים כאן ערכים אמיתיים.

# ---- כללי ----
# כתובת האתר הציבורית (למשל https://example.co.il). משמשת ל-redirect מסאמיט ול-CORS.
SITE_URL=
# רשימת origins מורשים ל-Functions, מופרדת בפסיקים. ברירת מחדל: SITE_URL.
ALLOWED_ORIGINS=

# true = מאפשר אינדוקס במנועי חיפוש. להפעיל רק בהשקה (שלב 5).
PUBLIC_INDEXABLE=
# true = כפתור התשלום שולח ל-create-order. עד שלב 2 מוצג במקום זה מעבר לוואטסאפ.
PUBLIC_CHECKOUT_ENABLED=

# ---- Supabase (שלב 0) ----
SUPABASE_URL=
# מפתח ציבורי לפי תכנון (RLS מגן). משמש את האדמין בדפדפן.
SUPABASE_ANON_KEY=
# סודי! רק ב-Netlify Functions. עוקף RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sumit (שלב 2) ----
# https://app.sumit.co.il/developers/keys/
SUMIT_COMPANY_ID=
SUMIT_API_KEY=

# ---- מייל (שלב 2) ----
RESEND_API_KEY=
EMAIL_FROM=
OWNER_NOTIFY_EMAIL=

# ---- מעקב ופיקסלים (שלב 3) ----
# מזהים ציבוריים (נכנסים לקוד הדפדפן). כשאף אחד לא מוגדר, אין באנר עוגיות ואין פיקסלים.
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=
PUBLIC_TIKTOK_PIXEL_ID=
# סודיים, לשליחה מהשרת בלבד (Conversions API / Measurement Protocol / Events API)
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=
GA4_API_SECRET=
TIKTOK_EVENTS_TOKEN=
# מלח ל-hash של rate limiting (לא שומרים IP)
RATE_LIMIT_SALT=

# שלב 4: build hook של Netlify. שינוי מחיר/משלוח/פרטי עסק במערכת הניהול בונה מחדש את האתר.
# נוצר אוטומטית ע"י scripts/setup/provision-supabase.mjs
NETLIFY_BUILD_HOOK_URL=
# לבנייה מקומית בלי גישה למסד (הקטלוג נופל לברירות המחדל שבקוד)
CATALOG_OFFLINE=
